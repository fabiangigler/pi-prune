{
  "name": "pi-prune",
  "version": "0.2.0",
  "description": "Continue a compacted Pi session without loading its discarded conversation history.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiangigler/pi-prune.git"
  },
  "keywords": ["pi-package", "pi-extension", "compaction"],
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "prune.ts", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
